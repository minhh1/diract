# Copy to .env.local and fill in. Same Supabase project as the web app --
# see the root .env.example. Only public/anon values belong here: Expo
# inlines every EXPO_PUBLIC_* var into the built app, so it is readable by
# anyone with the app bundle. Never put the service-role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web app origin, used for "open in browser" links to features not (yet)
# ported natively, and as the OAuth/password-reset web fallback.
EXPO_PUBLIC_APP_URL=https://diract.io
