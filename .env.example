# Copy to .env.local and fill in. See README.md.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google (Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook integration) -- requires an app registration in
# Entra ID / Azure Portal with a Mail.ReadWrite/offline_access/User.Read/
# MailboxSettings.Read delegated permission grant and this app's
# OUTLOOK_REDIRECT_URI added as a redirect URI. The outlook-* Supabase edge
# functions need these same three values set as edge function secrets too
# (`supabase secrets set MICROSOFT_CLIENT_ID=... MICROSOFT_CLIENT_SECRET=...
# MICROSOFT_TENANT=...`), same as GOOGLE_CLIENT_ID/SECRET already are for
# the gmail-* functions.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Shared secret Graph echoes back as clientState on every change
# notification, so the outlook-push edge function can reject spoofed
# webhook requests. Any random string; also needs setting as a Supabase
# edge function secret (not just here), since outlook-push runs in Deno,
# not Next.js -- see `supabase secrets set OUTLOOK_WEBHOOK_SECRET=...`.
OUTLOOK_WEBHOOK_SECRET=

# Xero (Accounting API) integration -- requires an app registered at
# https://developer.xero.com/app/manage (type: "Web app"), with
# ${NEXT_PUBLIC_APP_URL}/api/xero/callback added as the OAuth 2.0 redirect
# URI and the accounting.settings.read scope enabled. One shared app for
# every company (like GOOGLE_CLIENT_ID above), not BYO per company --
# each company's admin just connects their own Xero organisation(s) via
# Admin -> Xero. See lib/config.ts (XERO_SCOPES) and lib/xero/client.ts.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# .doc -> .docx conversion microservice (docservice/). Vercel can't run
# LibreOffice in a serverless function -- deploy docservice/ to a host you
# control (Fly.io, Railway, a small VPS). Defaults to a local Docker
# container for dev (see lib/gotenberg.ts).
GOTENBERG_URL=http://localhost:3033

# Apache Guacamole gateway (virtual computers feature, see lib/guacamole.ts).
# Vercel can't run guacd/guacamole-client either -- deploy guacamole/ to a
# host you control, same as docservice/. See guacamole/README.md.
GUACAMOLE_URL=http://localhost:8080/guacamole
NEXT_PUBLIC_GUACAMOLE_URL=http://localhost:8080/guacamole
GUACAMOLE_JSON_SECRET_KEY=

# Cloud provider credentials (DigitalOcean/AWS/GCP) for BYO-billed virtual
# computers are NOT env vars -- each company's admin enters their own in
# Admin -> Virtual Computers, stored in company_cloud_credentials.

# Stripe subscription billing (platform-billed virtual computers, see
# lib/billing/plans.ts, supabase/company_subscriptions.sql). Redirect-only
# Checkout/Billing Portal flow -- no Stripe.js on the client, so no
# publishable key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=

# Platform-owned cloud credentials for platform-billed virtual computers
# (the platform's own DO/AWS/GCP account -- distinct from each company's
# BYO company_cloud_credentials, see lib/vmProviders/platformCredentials.ts).
# Only DigitalOcean is provisionable so far (see lib/vmProviders/registry.ts).
DIGITALOCEAN_PLATFORM_API_TOKEN=

# Platform-owned Twilio account for SMS (see lib/sms/sendMessage.ts,
# app/api/sms/send/route.ts). Platform-funded and shared across every
# company, like DIGITALOCEAN_PLATFORM_API_TOKEN/TOGETHER_API_KEY above --
# there is no per-company BYO Twilio credentials table. TWILIO_FROM_NUMBER
# must be an SMS-capable Twilio number (E.164 format, e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Platform-hosted AI inference provider (Together AI) for the AI assistant's
# hosted open models and embeddings (see lib/billing/aiModels.ts,
# app/api/ai/chat/route.ts, supabase/functions/ai-embed-worker). Platform-
# funded like DIGITALOCEAN_PLATFORM_API_TOKEN above, not company-supplied --
# usage is metered per company and billed via Stripe (see
# lib/billing/aiUsageReporting.ts). Companies can also configure their own
# self-hosted Ollama URL instead/as well, per company, in Admin -> AI
# Assistant (no env var for that -- see ai_chat_settings.self_hosted_ollama_url).
TOGETHER_API_KEY=

# Platform-owned Resend account for outbound email -- task-assigned/
# archive-request notifications (see lib/email/sendEmail.ts) and, once the
# Supabase Auth "Send Email" hook is enabled in the dashboard, every login/
# signup/password-reset email too (see supabase/functions/auth-send-email).
# Platform-funded and shared across every company, like TWILIO_ACCOUNT_SID
# above -- a company can additionally verify its own sending domain under
# this same account (Admin -> Email), stored in company_email_domains, to
# get its emails branded instead of using EMAIL_FROM_DEFAULT.
#
# The two Edge Functions above run outside Next.js and need their own copies
# of these set via `supabase secrets set` (not read from this file):
# RESEND_API_KEY, EMAIL_FROM_DEFAULT, and SEND_EMAIL_HOOK_SECRET (the secret
# Supabase's dashboard generates when you enable the Send Email hook --
# there is no Next.js-side equivalent of this one).
RESEND_API_KEY=
EMAIL_FROM_DEFAULT="Diract <notifications@diract.io>"
